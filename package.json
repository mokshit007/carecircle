{
  "name": "carecircle",
  "version": "2.0.0",
  "description": "CareCircle: one Alexa+ for the whole family. A role-aware MCP server with MCP Apps views, Ring-aware routine-drift detection and Claude on Amazon Bedrock for older adults and their caregivers",
  "type": "module",
  "main": "src/server.js",
  "license": "MIT",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "smoke": "node scripts/smoke.js",
    "reset": "node -e \"import('./src/store.js').then(m => new m.Store().reset())\""
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^1.0.0",
    "@aws-sdk/client-sns": "^3.1155.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  }
}
