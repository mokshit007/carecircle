# --- Access -------------------------------------------------------------------------------
# Open access is for local demos only. Before the server is reachable by anyone else:
#   ALLOW_ANONYMOUS=false   every /mcp and /api call needs a token (OAuth-linked assistant or access code)
#   DEMO_TOKENS=false       turn off the fixed demo tokens (margaret-echo-demo, ...)
#   DEMO_MODE=false         turn off reset / simulated Ring events / picking who you are (defaults to ALLOW_ANONYMOUS)
#   PUBLIC_URL=https://...  the address assistants use; it becomes the OAuth issuer
ALLOW_ANONYMOUS=true
DEMO_TOKENS=true
DEMO_MODE=
PUBLIC_URL=
HOST=127.0.0.1
PORT=3000
ALLOWED_HOSTS=

# --- Claude on Amazon Bedrock (voice agent, drift explanations, digest, visit brief, label reading) ---
# Uses the standard AWS credential chain (aws configure, env vars, or an IAM role).
BEDROCK_ENABLED=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5

# --- Optional: Amazon SNS topic for caregiver SMS/email alerts ---
SNS_TOPIC_ARN=

# --- Ring Partner API webhook signing key (HMAC). The demo secret is used when empty. ---
RING_WEBHOOK_SECRET=

# --- Household ---
CARECIRCLE_TZ=
# Pin the time of day for repeatable demo recordings, e.g. 13:30
CARECIRCLE_CLOCK=
