# Claude on Amazon Bedrock (voice agent + weekly digest). Uses the standard AWS credential chain.
BEDROCK_ENABLED=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5

# MCP endpoint protection and exposure
MCP_AUTH_TOKEN=
HOST=127.0.0.1
PORT=3000
ALLOWED_HOSTS=

# Household
CARECIRCLE_RECIPIENT=Margaret
CARECIRCLE_TZ=
# Pin the time of day for repeatable demo recordings, e.g. 13:30
CARECIRCLE_CLOCK=
